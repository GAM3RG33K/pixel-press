# Allowlist: ignore everything at the top level, then re-include only
# app source and open-source project files.
/*

# Open-source project files
!/.gitignore
!/.github/
!/.github/workflows/
!/.github/workflows/**
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md

# Product record (impeccable) — durable product truth and design system
!/PRODUCT.md
!/DESIGN.md

# Landing page source (deployed to gh-pages by the Release workflow)
!/site/
!/site/**

# App source and config
!/src/
!/src-tauri/
!/src-tauri/src/
!/src-tauri/icons/
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
!/src-tauri/build.rs
!/src-tauri/tauri.conf.json
!/public/
!/vercel.json

# Rust build artifacts — never commit
src-tauri/target/
src-tauri/gen/
!/scripts/
!/tests/
!/e2e/
!/index.html
!/package.json
!/bun.lock
!/bunfig.toml
!/tsconfig*.json
!/vite.config.ts
!/vitest.config.ts
!/playwright.config.ts
!/tailwind.config.*
!/postcss.config.*
!/components.json
!/eslint.config.*
!/.prettierrc*
!/.editorconfig
!/.env.example

# Never commit, even inside allowed folders
node_modules/
dist/
coverage/
*.log
.env
.DS_Store
*.tsbuildinfo
.test-assets/
playwright-report/
test-results/
*.mp4
*.mov
*.mkv
*.avi
*.webm
!/public/**/*.webm
