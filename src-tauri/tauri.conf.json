{
  "productName": "pixel-press",
  "version": "0.1.7",
  "identifier": "com.pixelpress.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "bun run dev --port 5199 --strictPort --host 127.0.0.1",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pixel-press",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4Nzc2RkE4RDU4NkEyNkEKUldScW9vYlZxRzkzR0ErM1hDTElCc1BDUlhnTm1XMWFkaHMzYisrYVhnU1NnRklObU9LaUNTcTMK",
      "endpoints": [
        "https://github.com/GAM3RG33K/pixel-press/releases/latest/download/latest.json"
      ]
    }
  }
}
